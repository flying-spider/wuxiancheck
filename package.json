{
  "name": "proxy-browser",
  "version": "1.1.0",
  "description": "代理池浏览器：后台实时筛选优质代理IP，自动换IP",
  "author": "proxy-browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.infinite.query",
    "productName": "vivo无限查询",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sidecar/curlffi_proxy.exe",
        "to": "sidecar/curlffi_proxy.exe"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
